# Copy to .env. Real environment variables win. Set LLM_PROVIDER=gemini to use Gemini.
LLM_PROVIDER=gemini          # auto | gemini | anthropic | openai | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_SMALL=claude-haiku-5-5
DB_PATH=dejafix.db
LLM_TIMEOUT_SECONDS=30
JUDGE_MODE=borderline        # borderline | always | never
RATE_LIMIT_MESSAGES=30/60    # messages per user per N seconds
RATE_LIMIT_ESCALATIONS=5/60  # LLM escalations per user per N seconds (tighter)
