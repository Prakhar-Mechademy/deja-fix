# DATABASE_PATH: Optional SQLite file path (defaults to ./data/dejafix.db)
DATABASE_PATH="./data/dejafix.db"

# RATE_LIMIT_MESSAGES_PER_MIN: Per-user chat message limit per 60s window
RATE_LIMIT_MESSAGES_PER_MIN="20"

# RATE_LIMIT_ESCALATIONS_PER_MIN: Tighter per-user LLM escalation limit per 60s window
RATE_LIMIT_ESCALATIONS_PER_MIN="5"

# GEMINI_TIMEOUT_MS: Request timeout for backend Gemini calls in milliseconds
GEMINI_TIMEOUT_MS="25000"

# Optional model overrides (verified working defaults)
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
