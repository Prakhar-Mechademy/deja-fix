# Copy this file to .env and put your key in it. .env is git-ignored: never commit it.
GEMINI_API_KEY=

# Optional settings (defaults shown)
# LLM_PROVIDER: auto = gemini if GEMINI_API_KEY is set, otherwise mock (offline demo mode)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=30
DEJA_DB=data/dejafix.db
MSG_LIMIT_PER_MINUTE=20
ESCALATION_LIMIT_PER_HOUR=6
