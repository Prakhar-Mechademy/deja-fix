# Required for Gemini-based solving and semantic retrieval
GEMINI_API_KEY= your_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# SQLite database (default is backend/data/deja_fix.db)
# DATABASE_URL=sqlite:///./data/deja_fix.db

# Rate limits
MESSAGE_LIMIT=30
MESSAGE_WINDOW_SECONDS=60
ESCALATION_LIMIT=5
ESCALATION_WINDOW_SECONDS=3600

# Retrieval thresholds (cosine similarity)
RETRIEVAL_THRESHOLD=0.82
AMBIGUOUS_THRESHOLD=0.68
LLM_TIMEOUT_SECONDS=25
